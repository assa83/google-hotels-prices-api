    {
      "parameters": {
        "jsCode": "const MAX_PRICE = 150; // alert threshold per night, in the currency of the request\nreturn $input.all()\n  .filter(({ json }) => json.pricePerNight != null && json.pricePerNight <= MAX_PRICE)\n  .map(({ json }) => ({ json: {\n    alert: `${json.hotelName}: ${json.pricePerNight} ${json.currency}/night on ${json.lowestPriceVendor} (${json.checkInDate})`,\n    hotelName: json.hotelName, pricePerNight: json.pricePerNight, googleHotelsUrl: json.googleHotelsUrl,\n  } }));"
      },
